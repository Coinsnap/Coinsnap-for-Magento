<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Kept out of app/etc/config.php by app:config:dump, so keys and the webhook secret never end up in git. -->
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="payment/coinsnap_payment/api_key" xsi:type="string">1</item>
                <item name="payment/coinsnap_payment/btcpay_api_key" xsi:type="string">1</item>
                <item name="payment/coinsnap_payment/coinsnap_webhook" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>
</config>
